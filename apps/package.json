{
  "name": "noor-quran-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Windows, macOS, Android and iOS builds for Noor Quran",
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:site": "node scripts/prepare-site.mjs",
    "build:windows": "npm run prepare:site && electron-builder --win nsis portable --x64",
    "build:mac": "npm run prepare:site && electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "@capacitor/ios": "^8.0.0"
  },
  "build": {
    "appId": "ir.noorquran.desktop",
    "productName": "Noor Quran",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "shared/www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
